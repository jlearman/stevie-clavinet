<region> sample=flac/7_Cr.flac pitch_keycenter=c6 lokey=a#5

// Sfizz only.  With Aria, just use CC91, or the controls page reverb slider
<effect>
    type=fverb
    reverb_input=100
    reverb_dry=100
    reverb_wet=0 // set nonzero for baked in reverb
    // reverb_wet_oncc91=100 // doesn't work

